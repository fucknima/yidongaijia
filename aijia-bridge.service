[Unit]
Description=Mobile Aijia camera cloud stream bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aijia-camera
Group=aijia-camera
EnvironmentFile=/etc/aijia-camera/bridge.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/aijia-camera
ExecStart=/usr/bin/python3 /opt/aijia-camera/bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
